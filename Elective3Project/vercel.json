{
  "buildCommand": "npm install && npm run build && composer install",
  "outputDirectory": "public",
  "framework": "laravel",
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.6.1"
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ]
}